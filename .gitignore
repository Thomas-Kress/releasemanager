# --- Environment / secrets ---
# Contains B4A_REST_API_USERNAME/PASSWORD - never commit this.
.env
.env.*
!.env.example

input/

# --- Python (backend) ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node / React (frontend) ---
# (frontend/.gitignore also covers these for that subfolder specifically)
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Logs & runtime artifacts ---
*.log
pid.txt

# --- Editor / IDE ---
.vscode/*
!.vscode/extensions.json
.idea/
*.sw?
.claude/skills/

# --- OS ---
.DS_Store
Thumbs.db

# --- Local data ---
data/*.db*
